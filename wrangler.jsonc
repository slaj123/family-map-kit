{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "family-map",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  // 10 login tries per minute per IP, so the passcode can't be guessed by a script.
  "ratelimits": [
    { "name": "LOGIN_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "family-map", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "preview_database_id": "local-family-map", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "family-map-media" }
  ]
}
